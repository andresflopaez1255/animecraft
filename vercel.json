{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/animecraft/browser",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://api.animecraft.lat/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
